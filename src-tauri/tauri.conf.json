{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChUno",
  "version": "0.2.2",
  "identifier": "com.buro.chuno",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ChUno",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyQzIxQjAzMkVEQkZBNzIKUldSeSt0c3VBeHZDUW9EMUVqZGxQSDIwam14SVF2eWs1THBTb0ZHMENOaTkzdTQzbThGeHZHcjQK",
      "endpoints": [
        "https://github.com/Aishtero/chuno/releases/latest/download/latest.json"
      ]
    }
  }
}
